# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.
#
# ─────────────────────────────────────────────────────────────────────────────
# NEVER prefix any value in this file with NEXT_PUBLIC_.
#
# Next.js INLINES every NEXT_PUBLIC_* variable into the JavaScript it ships to
# the browser. A NEXT_PUBLIC_ secret is not "slightly exposed" — it is printed
# verbatim into a file anyone can open in devtools, and it stays in every
# cached copy of that bundle after you rotate the key.
#
# Everything below is read only in server code (route handlers, server
# components, lib/* modules guarded by `import "server-only"`), which is why
# none of it needs the prefix.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string.
# The database name is supplied separately via MONGO_DB_NAME (the srv URI does not need one).
MONGO_DB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=physio_castle

# Base URL used to build invite / password-reset links.
APP_URL=http://localhost:3000

# ── Lead notification email ──────────────────────────────────────────────────
# The public contact form emails the clinic. Resend is tried first, SMTP second;
# with neither configured the lead is logged to the server console instead.

# Resend API key — https://resend.com/api-keys. SECRET.
RESEND_API_KEY=
# Where leads are delivered, and the verified sender they come from.
CLINIC_LEAD_EMAIL=physiocastle1@gmail.com
EMAIL_FROM=onboarding@resend.dev

# Optional SMTP fallback, used only when RESEND_API_KEY is unset or fails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
